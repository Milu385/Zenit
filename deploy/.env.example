# Copiar a deploy/.env y completar. deploy/.env NO se versiona.

# Usuario u organizacion de GitHub en minusculas: las imagenes se etiquetan
# ghcr.io/<ORG_GITHUB>/zenit-*
ORG_GITHUB=
VERSION_INGESTA=0.4.0
VERSION_API=0.4.0
VERSION_WEB=0.2.0
VERSION_INFLUX=3-core

ZENIT_ENTORNO=plataforma
ZENIT_PROVEEDOR=digitalocean
ZENIT_REGION=nyc3

# Token compartido con los agentes: openssl rand -hex 32
TOKEN_INGESTA=

# Token de administracion de InfluxDB. NO se escribe a mano:
# lo genera scripts/influx/preparar-token.sh
INFLUX_TOKEN=

# service_name de las metricas que no pertenecen a ningun servicio
# (las del anfitrion). Decision pendiente del equipo.
SERVICIO_POR_DEFECTO=host

# Retencion de los tres niveles (documento de esquema de medicion, seccion 3).
# El nivel crudo pasa de 7 a 30 dias mientras dure la campana del laboratorio:
# la evaluacion necesita las semanas completas aunque falle una exportacion.
RETENCION_RAW=30d
RETENCION_1M=30d
RETENCION_1H=180d
# metricas de la propia plataforma (zenit_interno, H-021)
RETENCION_INTERNA=7d
# Cuanto rellena hacia atras el agregador la primera vez (por defecto, RETENCION_RAW)
AGREGACION_RELLENO=30d

# Clave de PostgreSQL (tablas del laboratorio, anomalias, diagnosticos y
# usuarios): openssl rand -hex 24. Se fija antes del primer arranque; si se
# cambia despues, PostgreSQL sigue con la vieja hasta borrar su volumen.
PG_CLAVE=

# --- descubrimiento de activos (epica 1, H-009) ---
# Cada proveedor se activa solo si su credencial esta. Todas de SOLO LECTURA
# (docs/proveedores.md dice como crearlas y como demostrarlo).
DESCUBRIMIENTO_CADA=900
# DigitalOcean: token con alcance de solo lectura
DO_TOKEN=
DO_ETIQUETA=zenit-nodo
# Proxmox: usuario@realm!idtoken=secreto, de un usuario con rol PVEAuditor.
# PROXMOX_CA es la ruta DENTRO del contenedor de la CA del cluster
# (/run/zenit/descubrimiento/proxmox-ca.pem si la copias a deploy/secretos/descubrimiento/).
PROXMOX_URL=
PROXMOX_TOKEN=
PROXMOX_CA=
PROXMOX_NOMBRE_TLS=
PROXMOX_ETIQUETA=zenit-nodo
# AWS: 1 solo durante las sesiones del Learner Lab, con las credenciales de la
# sesion en deploy/secretos/descubrimiento/aws-credenciales. Vencen cada 4 h;
# una ejecucion con credenciales vencidas queda en error y NO retira nada.
DESCUBRIR_AWS=0
AWS_REGION=us-east-1
