# --- identidad del entorno: lo unico que distingue a los cuatro ---
ZENIT_ENTORNO=lab
ZENIT_PROVEEDOR=azure
ZENIT_REGION=eastus
# nombre UNICO de este nodo: es la clave con la que la plataforma lo reconoce
ZENIT_NODO=zenit-nodo-azure

# --- tamaño del anfitrion ---
LIMITE_CPU=2.0
LIMITE_MEMORIA=2g

# --- destino de la telemetria: IP elastica de la plataforma, puerto del borde ---
# IDENTICO en los cuatro entornos. Si un entorno apunta a otro sitio,
# la comparacion entre entornos deja de medir el entorno.
DESTINO_OTLP=
OTLP_INSEGURO=false
RUTA_CA=/etc/otelcol/ca.crt
TOKEN_INGESTA=
INTERVALO_METRICAS=10s

# --- imagenes ---
ORG_GITHUB=
VERSION_APP=0.2.0

# --- almacen ---
ALMACEN_USUARIO=zenit
ALMACEN_CLAVE=
ALMACEN_BD=zenit

# --- carga ---
CARGA_RPS=5
# tope de peticiones en vuelo: durante una caida no se acumulan miles
CARGA_MAX_EN_VUELO=50
CARGA_DURACION=0
# perfil diurno de H-023 (laboratorio/perfiles/diurno.json); vacio = CARGA_RPS fija
CARGA_PERFIL=/perfiles/diurno.json

# --- laboratorio de fallos (perfil "laboratorio") ---
# horas sin inyecciones al arrancar la campana por primera vez
CALENTAMIENTO_H=12
# minutos entre el inicio de una inyeccion y el de la siguiente
INTERVALO_MIN=60
INTERVALO_MAX=150
# minutos minimos de normalidad entre el fin real de una inyeccion y la siguiente
NORMAL_MIN=45
CAMPANA_SEMILLA=1
CAMPANA_TIPOS=cpu,memoria,disco_gradual,disco_abrupto,caida
SERVICIOS_CAIDA=catalogo,pedidos

# --- emparejado con el perfil "observado" ---
EXPORTADOR_TRAZAS=otlp
