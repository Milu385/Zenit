# --- identidad del entorno: lo unico que distingue a los cuatro ---
ZENIT_ENTORNO=lab
ZENIT_PROVEEDOR=proxmox
ZENIT_REGION=local
# nombre UNICO de este nodo: es la clave con la que la plataforma lo reconoce
ZENIT_NODO=zenit-nodo-onprem
# on-premise expone pedidos en la red del laboratorio (los demas: 127.0.0.1 por defecto)
IP_PEDIDOS=0.0.0.0

# --- tamaño del anfitrion ---
LIMITE_CPU=4.0
LIMITE_MEMORIA=4g

# --- destino de la telemetria: IP elastica de la plataforma, puerto del borde ---
# IDENTICO en los cuatro entornos. Si un entorno apunta a otro sitio,
# la comparacion entre entornos deja de medir el entorno.
DESTINO_OTLP=
OTLP_INSEGURO=false
RUTA_CA=/etc/otelcol/ca.crt
TOKEN_INGESTA=
INTERVALO_METRICAS=15s

# --- imagenes ---
ORG_GITHUB=
VERSION_APP=0.1.0

# --- almacen ---
ALMACEN_USUARIO=zenit
ALMACEN_CLAVE=
ALMACEN_BD=zenit

# --- carga ---
CARGA_RPS=5
CARGA_CONCURRENCIA=4
CARGA_DURACION=0

# --- emparejado con el perfil "observado" ---
EXPORTADOR_TRAZAS=otlp
