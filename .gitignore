# NUNCA subir archivos de entorno reales
*.env
!*.env.example
!laboratorio/entornos/*.env.example

# claves
*.pem
*.key

__pycache__/
.venv/
tls/*.srl
tls/servidor.crt

# token de administracion de InfluxDB (lo crea scripts/influx/preparar-token.sh)
deploy/secretos/
deploy/tls/

.pytest_cache/
node_modules/
frontend/dist/

# exportaciones de datos del laboratorio (scripts/exportar.sh)
exportaciones/

# mTLS (H-012): certificados y claves de cliente de los agentes
tls/clientes/
laboratorio/agente/cliente/

# paquetes de Python descargados por error
*.whl

# metadatos de carpeta de macOS
.DS_Store

# modelos entrenados: se regeneran ejecutando los cuadernos de Modelos/.
# El objeto de resultados de statsmodels pesa unos 19 MB y es fragil entre
# versiones de la biblioteca; lo que se versiona es el cuaderno y su
# especificacion en JSON.
*.pkl
