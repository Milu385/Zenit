# Contexto de construccion: backend/
FROM python:3.12-slim
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY zenit/ ./zenit/
RUN useradd --uid 1000 --no-create-home zenit
USER zenit
EXPOSE 8000
CMD ["uvicorn", "zenit.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
